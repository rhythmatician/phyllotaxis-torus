#version 430

// Pass A: Build 2D "ink SDF" texture in UV space
// This shader computes a signed-distance field encoding dots and edges
// in the (u,v) parameter space of the torus surface.

layout(local_size_x = 8, local_size_y = 8) in;

// Output: 2D SDF texture (R32F format)
layout(r32f, binding = 0) uniform image2D inkSDFTexture;

// Input: Node data (dots)
layout(std430, binding = 1) buffer NodeUVBuffer {
    vec2 nodeUV[];  // (u, v) coordinates for each node
};

layout(std430, binding = 2) buffer NodeRadiiBuffer {
    float nodeRadii[];  // Radius for each dot in UV space
};

// Input: Edge data (lines)
layout(std430, binding = 3) buffer EdgeUVBuffer {
    vec4 edgeUV[];  // (u0, v0, u1, v1) for each edge
};

layout(std430, binding = 4) buffer EdgeRadiiBuffer {
    float edgeRadii[];  // Radius for each line in UV space
};

// Uniforms
uniform int numNodes;
uniform int numEdges;
uniform float torusR;  // Major radius
uniform float torusr;  // Minor radius
uniform float smoothK;  // Smoothing factor for blending
uniform int texWidth;
uniform int texHeight;

// Constants
const float PI = 3.14159265359;
const float TWO_PI = 6.28318530718;

// Wrap angle difference to [-PI, PI]
float wrap_angle_diff(float a, float b) {
    float diff = a - b;
    // Wrap to [-PI, PI]
    while (diff > PI) diff -= TWO_PI;
    while (diff < -PI) diff += TWO_PI;
    return diff;
}

// Compute distance on torus surface using the surface metric
// ds² = (R + r·cos(v))²·du² + r²·dv²
float torus_surface_distance(vec2 uv1, vec2 uv2, float R, float r) {
    float u1 = uv1.x, v1 = uv1.y;
    float u2 = uv2.x, v2 = uv2.y;
    
    // Wrap differences to shortest path
    float du = wrap_angle_diff(u2, u1);
    float dv = wrap_angle_diff(v2, v1);
    
    // Compute metric tensor components at midpoint
    float v_mid = v1 + dv * 0.5;
    float metric_uu = (R + r * cos(v_mid)) * (R + r * cos(v_mid));
    float metric_vv = r * r;
    
    // Distance via Riemannian metric
    return sqrt(metric_uu * du * du + metric_vv * dv * dv);
}

// SDF for a dot at given UV position
float dot_sdf(vec2 query_uv, vec2 dot_uv, float radius, float R, float r) {
    float dist = torus_surface_distance(query_uv, dot_uv, R, r);
    return dist - radius;
}

// SDF for an edge (line segment) in UV space
float edge_sdf(vec2 query_uv, vec2 uv0, vec2 uv1, float radius, float R, float r) {
    // Wrap edge endpoints to shortest path
    float du_edge = wrap_angle_diff(uv1.x, uv0.x);
    float dv_edge = wrap_angle_diff(uv1.y, uv0.y);
    
    // Parametric line: uv(t) = uv0 + t * delta_uv, t ∈ [0,1]
    // Find closest point on segment via projection
    
    // Query relative to uv0
    float du_query = wrap_angle_diff(query_uv.x, uv0.x);
    float dv_query = wrap_angle_diff(query_uv.y, uv0.y);
    
    // Metric tensor at uv0
    float v0 = uv0.y;
    float metric_uu = (R + r * cos(v0)) * (R + r * cos(v0));
    float metric_vv = r * r;
    
    // Projection: t = <query, edge> / <edge, edge>
    float dot_query_edge = metric_uu * du_query * du_edge + metric_vv * dv_query * dv_edge;
    float dot_edge_edge = metric_uu * du_edge * du_edge + metric_vv * dv_edge * dv_edge;
    
    float t = clamp(dot_query_edge / max(dot_edge_edge, 1e-8), 0.0, 1.0);
    
    // Closest point on segment
    vec2 closest_uv = vec2(
        uv0.x + t * du_edge,
        uv0.y + t * dv_edge
    );
    
    // Distance from query to closest point
    float dist = torus_surface_distance(query_uv, closest_uv, R, r);
    return dist - radius;
}

// Smooth minimum (Inigo Quilez polynomial)
float smooth_min(float d1, float d2, float k) {
    float h = clamp(0.5 + 0.5 * (d2 - d1) / k, 0.0, 1.0);
    return mix(d2, d1, h) - k * h * (1.0 - h);
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    
    // Check bounds
    if (texel.x >= texWidth || texel.y >= texHeight) {
        return;
    }
    
    // Convert texel to UV coordinates in [-PI, PI]
    float u = (float(texel.x) / float(texWidth)) * TWO_PI - PI;
    float v = (float(texel.y) / float(texHeight)) * TWO_PI - PI;
    vec2 query_uv = vec2(u, v);
    
    // Initialize SDF to a large value
    float sdf = 1e10;
    
    // Union with all dots
    for (int i = 0; i < numNodes; i++) {
        float dot_dist = dot_sdf(query_uv, nodeUV[i], nodeRadii[i], torusR, torusr);
        sdf = smooth_min(sdf, dot_dist, smoothK);
    }
    
    // Union with all edges
    for (int i = 0; i < numEdges; i++) {
        vec2 uv0 = edgeUV[i].xy;
        vec2 uv1 = edgeUV[i].zw;
        float edge_dist = edge_sdf(query_uv, uv0, uv1, edgeRadii[i], torusR, torusr);
        sdf = smooth_min(sdf, edge_dist, smoothK);
    }
    
    // Store result in texture
    imageStore(inkSDFTexture, texel, vec4(sdf, 0.0, 0.0, 0.0));
}
