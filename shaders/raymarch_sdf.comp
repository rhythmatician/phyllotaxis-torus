#version 430

// Work group size
layout(local_size_x = 8, local_size_y = 8) in;

// Uniforms (camera and rendering parameters)
uniform int numNodes;
uniform int numEdges;
uniform float torus_R;          // Major radius
uniform float torus_r;          // Minor radius
uniform float shell_thickness;   // Thickness of inside shell band
// node_radius is now per-node in buffer binding 5
uniform float edge_radius;      // Radius of edge capsules
uniform float smooth_k;         // Smoothing factor for junctions
uniform float hit_eps;
uniform float eps_t;
uniform float t_max;
uniform int max_steps;
uniform vec3 camera_pos;
uniform vec3 camera_right;
uniform vec3 camera_up;
uniform vec3 camera_forward;
uniform float focal_length;
uniform int width;
uniform int height;
uniform int use_ray_buffer;
uniform vec3 light_dir;
uniform float ambient;
uniform float diffuse_strength;
uniform float specular_strength;
uniform float shininess;

// Shader Storage Buffer Objects (SSBOs)
layout(std430, binding = 0) buffer NodePositions {
    vec3 node_positions[];  // 3D positions of nodes on torus surface
};

layout(std430, binding = 1) buffer NodeColors {
    vec4 node_colors[];     // RGBA colors for nodes
};

layout(std430, binding = 5) buffer NodeRadii {
    float node_radii[];     // Per-node radii in world space
};

layout(std430, binding = 2) buffer EdgeIndices {
    ivec2 edge_indices[];   // Pairs of node indices (i0, i1)
};

layout(std430, binding = 3) buffer EdgeColors {
    vec4 edge_colors[];     // RGBA colors for edges
};

layout(std430, binding = 4) buffer OutputImage {
    vec4 output_pixels[];
};

// Optional ray directions buffer (precomputed on CPU)
layout(std430, binding = 6) buffer RayDirs {
    vec4 ray_dirs[];
};

// ============================================================================
// SDF Primitives
// ============================================================================

// Torus SDF
float torus_sdf(vec3 pos, float R, float r) {
    vec2 q = vec2(length(pos.xy) - R, pos.z);
    return length(q) - r;
}

// torus cavity (hollow interior) SDF
// Returns negative inside the hollow interior, positive outside the shell
float hollow_torus_sdf(vec3 pos, float R, float r) {
    vec2 q = vec2(length(pos.xy) - R, pos.z);
    return r - length(q);
}

// Sphere SDF
float sphere_sdf(vec3 pos, vec3 center, float radius) {
    return length(pos - center) - radius;
}

// Capsule SDF (line segment with rounded ends)
float capsule_sdf(vec3 pos, vec3 a, vec3 b, float radius) {
    vec3 pa = pos - a;
    vec3 ba = b - a;
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h) - radius;
}

// ============================================================================
// Boolean Operations
// ============================================================================

// Union
float op_union(float d1, float d2) {
    return min(d1, d2);
}

// Smooth union (Inigo Quilez polynomial smooth min)
float op_smooth_union(float d1, float d2, float k) {
    float h = clamp(0.5 + 0.5 * (d2 - d1) / k, 0.0, 1.0);
    return mix(d2, d1, h) - k * h * (1.0 - h);
}

// Intersection
float op_intersection(float d1, float d2) {
    return max(d1, d2);
}

// Difference (subtract d2 from d1)
float op_difference(float d1, float d2) {
    return max(d1, -d2);
}

// ============================================================================
// Scene SDF
// ============================================================================

// Single edge as ink line on the interior surface of the torus
// (not floating in the interior volume, but on the inside-facing surface)
// Projects a point onto the nearest point on the inner torus shell
vec3 project_to_inner_shell(vec3 pos, float R, float r) {
    // Get the circle center in the XY plane
    vec2 posXY = pos.xy;
    float distXY = length(posXY);

    if (distXY < 0.0001) {
        // Handle degenerate case at the center
        return vec3(R - r, 0.0, pos.z);
    }

    vec2 dirXY = posXY / distXY;
    // The inner shell is at distance (R - r) from the center
    vec2 circleCenter = dirXY * R;

    // Project to the inner circle
    vec3 toPos = pos - vec3(circleCenter, 0.0);
    float dist = length(toPos);

    if (dist < 0.0001) {
        // Handle degenerate case
        return vec3(circleCenter, -r);
    }

    vec3 dir = toPos / dist;
    return vec3(circleCenter, 0.0) + dir * r;
}

// Edge as line segment between two nodes
// The endpoints are on the torus surface, but the straight-line capsule cuts through space.
// We need to INTERSECT the capsule with the torus surface to constrain it.
float edge_ink_sdf(vec3 pos, vec3 a, vec3 b, float line_width, float R, float r, float thickness) {
    // 3D capsule between endpoints
    float capsule = capsule_sdf(pos, a, b, line_width);

    // Torus surface (use solid torus at r_inner)
    float torus = torus_sdf(pos, R, r);

    // INTERSECTION: only where the capsule AND torus surface meet
    // This constrains the line to follow the torus surface
    return op_intersection(capsule, torus);
}

// All edges as ink network
float edges_network_sdf(vec3 pos) {
    if (numEdges == 0) {
        return 1e10;
    }

    float result = 1e10;
    for (int i = 0; i < numEdges; i++) {
        ivec2 edge = edge_indices[i];
        vec3 a = node_positions[edge.x];
        vec3 b = node_positions[edge.y];
        float d = edge_ink_sdf(pos, a, b, edge_radius, torus_R, torus_r, shell_thickness);
        result = op_union(result, d);
    }
    return result;
}

// Single node sphere - just a sphere at the given position
// The positions are already on the torus surface, so no need to constrain
float node_sphere_sdf(vec3 pos, int idx) {
    vec3 center = node_positions[idx];
    float radius = node_radii[idx];  // Use per-node radius
    return sphere_sdf(pos, center, radius);
}

// All node spheres
float nodes_sdf(vec3 pos) {
    if (numNodes == 0) {
        return 1e10;
    }

    float result = 1e10;
    for (int i = 0; i < numNodes; i++) {
        float d = node_sphere_sdf(pos, i);
        result = op_union(result, d);
    }
    return result;
}

// Combined scene: smooth union at junctions
float scene_sdf(vec3 pos, out int hit_type, out int hit_idx) {
    // hit_type: 0 = node, 1 = edge
    // hit_idx: index of node or edge
    // Note: Torus is NOT included - only ink (nodes + edges)

    float nodes_dist = nodes_sdf(pos);
    float edges_dist = edges_network_sdf(pos);

    // Smooth union between nodes and edges at junctions
    float ink_dist = op_smooth_union(nodes_dist, edges_dist, smooth_k);

    // Determine hit type based on which is closest
    if (nodes_dist <= edges_dist) {
        hit_type = 0;  // Node
        // Find which node
        hit_idx = 0;
        if (numNodes > 0) {
            float min_dist = node_sphere_sdf(pos, 0);
            for (int i = 1; i < numNodes; i++) {
                float d = node_sphere_sdf(pos, i);
                if (d < min_dist) {
                    min_dist = d;
                    hit_idx = i;
                }
            }
        }
    } else {
        hit_type = 1;  // Edge
        // Find which edge (approximate - closest endpoint)
        hit_idx = 0;
        if (numEdges > 0) {
            float min_dist = 1e10;
            for (int i = 0; i < numEdges; i++) {
                ivec2 edge = edge_indices[i];
                vec3 a = node_positions[edge.x];
                vec3 b = node_positions[edge.y];
                vec3 mid = (a + b) * 0.5;
                float d = length(pos - mid);
                if (d < min_dist) {
                    min_dist = d;
                    hit_idx = i;
                }
            }
        }
    }

    return ink_dist;
}

// ============================================================================
// Shading
// ============================================================================

// Estimate normal using gradient
vec3 estimate_normal(vec3 pos, float eps) {
    vec2 e = vec2(eps, 0.0);
    int dummy_type, dummy_idx;
    return normalize(vec3(
        scene_sdf(pos + e.xyy, dummy_type, dummy_idx) - scene_sdf(pos - e.xyy, dummy_type, dummy_idx),
        scene_sdf(pos + e.yxy, dummy_type, dummy_idx) - scene_sdf(pos - e.yxy, dummy_type, dummy_idx),
        scene_sdf(pos + e.yyx, dummy_type, dummy_idx) - scene_sdf(pos - e.yyx, dummy_type, dummy_idx)
    ));
}

// Phong shading with multiple light sources for interior illumination
vec3 phong_shade(
    vec3 base_color,
    vec3 normal,
    vec3 view_dir,
    vec3 light_dir_param,
    float ambient_param,
    float diffuse_strength_param,
    float specular_strength_param,
    float shininess_param
) {
    // Normalize inputs
    vec3 light_dir_norm = normalize(light_dir_param);
    vec3 normal_norm = normalize(normal);
    vec3 view_dir_norm = normalize(view_dir);

    // Ambient component
    vec3 ambient_col = ambient_param * base_color;

    // PRIMARY LIGHT: Main directional light
    float diff = max(dot(normal_norm, light_dir_norm), 0.0);
    vec3 diffuse_col = diffuse_strength_param * diff * base_color;

    // Specular component (Blinn-Phong) - applied to base_color to preserve color
    vec3 half_vec_unnorm = view_dir_norm + light_dir_norm;
    float half_vec_len = length(half_vec_unnorm);
    vec3 half_vec = half_vec_unnorm / max(half_vec_len, 1e-6);
    float spec = max(dot(normal_norm, half_vec), 0.0);
    float spec_pow = pow(spec, shininess_param);
    // Match CPU shading: white specular highlight
    vec3 specular_col = specular_strength_param * spec_pow * vec3(1.0);

    return ambient_col + diffuse_col + specular_col;
}

// Get color based on hit type and index
vec4 get_hit_color(int hit_type, int hit_idx) {
    if (hit_type == 0) {
        // Node
        if (hit_idx >= 0 && hit_idx < numNodes) {
            return node_colors[hit_idx];
        }
    } else if (hit_type == 1) {
        // Edge
        if (hit_idx >= 0 && hit_idx < numEdges) {
            return edge_colors[hit_idx];
        }
    } else {
        // Torus shell - dark gray
        return vec4(0.2, 0.2, 0.2, 1.0);
    }
    return vec4(1.0);  // White fallback
}

// ============================================================================
// Main Ray Marching
// ============================================================================

void main() {
    // Get pixel coordinates
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    // Check bounds
    if (pixel.x >= width || pixel.y >= height) {
        return;
    }

    // Compute ray direction for this pixel
    vec3 ray_dir;
    if (use_ray_buffer == 1) {
        int pix_index = pixel.y * width + pixel.x;
        ray_dir = normalize(ray_dirs[pix_index].xyz);
    } else {
        float aspect = float(width) / float(height);

        // Normalized device coordinates [-1, 1] x [-1, 1]
        float x_ndc = ((float(pixel.x) + 0.5) / float(width)) * 2.0 - 1.0;
        float y_ndc = 1.0 - ((float(pixel.y) + 0.5) / float(height)) * 2.0;

        // Apply aspect ratio
        x_ndc *= aspect;

        // Compute ray direction in camera space
        float dx = x_ndc / focal_length;
        float dy = y_ndc / focal_length;
        float dz = 1.0;

        // Transform to world space
        ray_dir = normalize(
            dx * camera_right +
            dy * camera_up +
            dz * camera_forward
        );
    }

    vec3 ray_origin = camera_pos;

    // Pass 1: march to torus surface only to get occlusion depth
    float t_torus = 0.0;
    bool torus_hit = false;
    for (int step = 0; step < max_steps; step++) {
        vec3 pos = ray_origin + t_torus * ray_dir;
        float d = abs(torus_sdf(pos, torus_R, torus_r));
        if (d < hit_eps) { torus_hit = true; break; }
        t_torus += max(d, hit_eps * 0.5);
        if (t_torus > t_max) break;
    }

    // Pass 2: analytic ray–sphere intersections for all nodes
    float best_t = 1e20;
    int best_i = -1;
    for (int i = 0; i < numNodes; i++) {
        vec3 center = node_positions[i];
        float radius = node_radii[i];
        vec3 L = center - ray_origin;
        float b = dot(ray_dir, L);
        float c = dot(L, L) - radius * radius;
        float disc = b * b - c;
        if (disc > 0.0) {
            float t_s = b - sqrt(disc);
            if (t_s > 0.0 && t_s < best_t) {
                best_t = t_s;
                best_i = i;
            }
        }
    }

    bool hit_ink = false;
    bool hit_torus = false;
    vec3 hit_pos;
    int hit_type = -1;
    int hit_idx = -1;

    if (best_i >= 0 && (!torus_hit || best_t <= t_torus + eps_t)) {
        // Sphere is visible (not occluded by torus) - use eps_t to match CPU
        hit_ink = true;
        hit_type = 0;
        hit_idx = best_i;
        hit_pos = ray_origin + best_t * ray_dir;
    } else if (torus_hit) {
        hit_torus = true;
        hit_pos = ray_origin + t_torus * ray_dir;
    }

    // Compute output color
    vec4 color;

    if (hit_ink) {
        // Hit ink (node or edge) - apply shading
        vec4 base_color = get_hit_color(hit_type, hit_idx);

        // Compute normal at hit point
        vec3 normal;
        if (hit_type == 0) {
            // Analytical normal for sphere: radial from center
            vec3 center = node_positions[hit_idx];
            normal = normalize(hit_pos - center);
        } else {
            // Fallback to gradient-based normal for edges
            normal = estimate_normal(hit_pos, hit_eps * 2.0);
        }

        // Compute view direction (from hit point toward camera)
        vec3 view_dir_unnorm = camera_pos - hit_pos;
        float view_len = length(view_dir_unnorm);
        vec3 view_dir = view_dir_unnorm / max(view_len, 1e-6);

        // Apply Phong shading
        vec3 shaded_color = phong_shade(
            base_color.rgb,
            normal,
            view_dir,
            light_dir,
            ambient,
            diffuse_strength,
            specular_strength,
            shininess
        );

        color = vec4(shaded_color, base_color.a);
    } else if (hit_torus) {
        // Hit torus surface - render as black (the torus shell)
        color = vec4(0.0, 0.0, 0.0, 1.0);
    } else {
        // No hit - ray escaped without hitting anything
        // Render as white (background/artifact)
        color = vec4(1.0, 1.0, 1.0, 1.0);
    }

    // Write to output buffer
    int idx = pixel.y * width + pixel.x;
    output_pixels[idx] = color;
}
