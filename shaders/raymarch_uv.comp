#version 430

// Pass B: Ray march torus and sample ink SDF texture
// This shader ray-marches only the torus surface (O(1) primitive per pixel),
// then samples the pre-computed ink SDF texture to determine coloring.

layout(local_size_x = 8, local_size_y = 8) in;

// Output: RGBA image
layout(rgba32f, binding = 0) uniform image2D outputImage;

// Input: Ink SDF texture (from Pass A)
uniform sampler2D inkSDFTexture;
uniform sampler2D inkColorTexture;
uniform isampler2D seedIdTexture;

layout(std430, binding = 2) buffer NodeUVBuffer {
    vec2 nodeUV[];
};

layout(std430, binding = 3) buffer NodeRadiiBuffer {
    float nodeRadii[];
};

// Uniforms: Scene parameters
uniform int screenWidth;
uniform int screenHeight;
uniform float torusR;  // Major radius
uniform float torusr;  // Minor radius
uniform float inkThreshold;  // SDF threshold for ink visibility
uniform float inkSmoothness;  // Smoothness of ink edge
uniform float hit_eps;
uniform float t_max;
uniform int max_steps;
uniform int numNodes;
uniform float camera_f;

// Uniforms: Camera
uniform vec3 camera_pos;
uniform vec3 camera_right;
uniform vec3 camera_up;
uniform vec3 camera_forward;

// Uniforms: Lighting
uniform vec3 light_dir;
uniform float ambient;
uniform float diffuse_strength;
uniform float specular_strength;
uniform float shininess;

// Uniforms: Colors
uniform vec4 backgroundColor;  // Background color

// Constants
const float PI = 3.14159265359;
const float TWO_PI = 6.28318530718;

// Torus SDF: Inside tube is negative, outside is positive
float torus_sdf(vec3 p, float R, float r) {
    float rho = length(p.xy);
    float d_ring = length(vec2(rho - R, p.z));
    return d_ring - r;  // Positive outside the tube, negative inside
}

// Hollow torus SDF: cavity inside, solid outside
// Inside the tube (cavity): negative SDF
// Outside the tube (solid): positive SDF
// For ray marching from inside the cavity, we look for SDF crossing zero outward
float hollow_torus_sdf(vec3 p, float R, float r) {
    float rho = length(p.xy);
    float d_ring = length(vec2(rho - R, p.z));
    return d_ring - r;  // Negative inside cavity, positive outside solid
}

// Estimate normal via gradient
vec3 estimate_normal(vec3 p, float R, float r) {
    const vec3 e = vec3(0.01, 0.0, 0.0);  // Increased epsilon for better gradient
    vec3 grad = vec3(
        hollow_torus_sdf(p + e.xyy, R, r) - hollow_torus_sdf(p - e.xyy, R, r),
        hollow_torus_sdf(p + e.yxy, R, r) - hollow_torus_sdf(p - e.yxy, R, r),
        hollow_torus_sdf(p + e.yyx, R, r) - hollow_torus_sdf(p - e.yyx, R, r)
    );
    float grad_len = length(grad);
    if (grad_len < 1e-6) return vec3(0.0, 0.0, 1.0);  // Fallback if gradient is degenerate
    return grad / grad_len;
}

// Compute UV coordinates for a point on the torus
vec2 compute_uv(vec3 p, float R) {
    // u = atan(y, x) in [-PI, PI]
    float u = atan(p.y, p.x);
    
    // v = atan(z, rho - R) in [-PI, PI]
    float rho = length(p.xy);
    float v = atan(p.z, rho - R);
    
    return vec2(u, v);
}

// Convert UV from [-PI, PI] to texture coordinates [0, 1]
vec2 uv_to_texcoord(vec2 uv) {
    vec2 tex = vec2(
        (uv.x + PI) / TWO_PI,
        (uv.y + PI) / TWO_PI
    );
    return fract(tex);
}

// Phong shading
vec3 phong_shade(vec3 normal, vec3 view_dir, vec3 light_dir, vec3 base_color) {
    light_dir = normalize(light_dir);
    // Ambient
    vec3 color = ambient * base_color;
    
    // Diffuse
    float diff = max(dot(normal, light_dir), 0.0);
    color += diffuse_strength * diff * base_color;
    
    // Specular (Blinn-Phong half-vector to match CPU)
    vec3 half_vec = normalize(view_dir + light_dir);
    float spec = pow(max(dot(normal, half_vec), 0.0), shininess);
    color += specular_strength * spec * vec3(1.0);
    
    return color;
}

vec3 torus_point_from_uv(vec2 uv, float R, float r) {
    float cu = cos(uv.x);
    float su = sin(uv.x);
    float cv = cos(uv.y);
    float sv = sin(uv.y);
    return vec3((R + r * cv) * cu, (R + r * cv) * su, r * sv);
}

// Smooth step function for ink blending
float smooth_ink_alpha(float sdf, float threshold, float smoothness) {
    // sdf < 0 means inside ink feature
    // Create smooth transition around threshold
    float edge_dist = sdf - threshold;
    return 1.0 - smoothstep(-smoothness, smoothness, edge_dist);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    
    // Check bounds
    if (pixel.x >= screenWidth || pixel.y >= screenHeight) {
        return;
    }
    
    // Compute ray direction
    float aspect = float(screenWidth) / float(screenHeight);
    float u = (2.0 * float(pixel.x) / float(screenWidth - 1) - 1.0) * aspect;
    float v = 1.0 - 2.0 * float(pixel.y) / float(screenHeight - 1);
    u /= camera_f;
    v /= camera_f;
    
    vec3 ray_origin = camera_pos;
    vec3 ray_dir = normalize(camera_forward + u * camera_right + v * camera_up);
    
    // Ray march the torus
    float t = 0.0;
    bool hit = false;
    vec3 hit_pos;
    
    for (int step = 0; step < max_steps; step++) {
        hit_pos = ray_origin + t * ray_dir;
        float dist = hollow_torus_sdf(hit_pos, torusR, torusr);
        
        if (abs(dist) < hit_eps) {
            t -= dist;
            hit_pos = ray_origin + t * ray_dir;
            hit = true;
            break;
        }
        
        if (t > t_max) {
            break;
        }
        
        // Sphere tracing: step by absolute distance to surface
        float step_size = max(abs(dist), hit_eps);
        t += step_size;
    }
    
    vec4 final_color;
    
    if (hit) {
        // Compute UV coordinates at hit point
        vec2 uv = compute_uv(hit_pos, torusR);
        vec2 tex_coord = uv_to_texcoord(uv);
        
        // Sample ink SDF texture
        float ink_sdf = texture(inkSDFTexture, tex_coord).r;
        
        // Compute ink alpha based on SDF value
        float ink_alpha = smooth_ink_alpha(ink_sdf, inkThreshold, inkSmoothness);
        ivec2 tex_size = textureSize(seedIdTexture, 0);
        ivec2 texel = ivec2(fract(tex_coord) * vec2(tex_size));
        int seed_id = texelFetch(seedIdTexture, texel, 0).r;
        bool has_sphere_hit = false;
        vec3 hit_sphere = hit_pos;
        if (seed_id >= 0 && seed_id < numNodes) {
            vec3 center = torus_point_from_uv(nodeUV[seed_id], torusR, torusr);
            float radius = nodeRadii[seed_id];
            vec3 oc = ray_origin - center;
            float b = dot(oc, ray_dir);
            float c = dot(oc, oc) - radius * radius;
            float disc = b * b - c;
            if (disc > 0.0) {
                float t_sphere = -b - sqrt(disc);
                if (t_sphere > 0.0) {
                    hit_sphere = ray_origin + t_sphere * ray_dir;
                    has_sphere_hit = true;
                    ink_alpha = 1.0;
                }
            }
        }
        
        // If ink is present, render it with shading to match CPU
        if (ink_alpha > 0.0) {
            // Compute normal for shading
            vec3 normal = estimate_normal(hit_pos, torusR, torusr);
            vec3 view_dir = normalize(camera_pos - hit_pos);
            if (has_sphere_hit && seed_id >= 0 && seed_id < numNodes) {
                vec3 center = torus_point_from_uv(nodeUV[seed_id], torusR, torusr);
                normal = normalize(hit_sphere - center);
                view_dir = normalize(camera_pos - hit_sphere);
            }
            vec3 base_color = texture(inkColorTexture, tex_coord).rgb;
            vec3 shaded_ink = phong_shade(normal, view_dir, light_dir, base_color);
            vec3 blended = mix(backgroundColor.rgb, shaded_ink, ink_alpha);
            final_color = vec4(blended, 1.0);
        } else {
            // Non-ink areas render as black
            final_color = vec4(0.0, 0.0, 0.0, 1.0);
        }
    } else {
        // Ray missed - use background color
        final_color = backgroundColor;
    }
    
    // Write output
    imageStore(outputImage, pixel, final_color);
}
